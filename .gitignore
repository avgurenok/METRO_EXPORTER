# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Compiled Shader files
*.cso

# Precompiled Headers
*.gch
*.pch
src/shaders/*.h

# Executables
*.exe
*.out
*.app

# configs
*.user

# resources
res.aps

# folders
.vs
x64
_build

# The game's own data. This is an 8 GB copy of Metro 2033 Redux that lives here only so
# the extractor has something to read - it is Deep Silver's, not ours, and GitHub would
# refuse the files anyway.
Metro 2033 Redux/

# A prebuilt copy of an older build of this program, dropped in for comparison. Binaries,
# not source.
MetroEX_полуработающая программа/
MetroEX_*/

# build leftovers
*.pdb
*.bak
*.ipdb
*.iobj

# The ready-to-run Windows build is committed deliberately - see release/README.md.
# These have to override the *.exe and _build rules above, so they come last.
!release/
!release/**

# ...and so do the FBX SDK binaries, otherwise a fresh clone has the headers but
# nothing to link against. The 'x64' rule above would swallow the whole directory,
# so the directory itself has to be un-ignored before anything inside it can be.
!libs/fbx/lib/x64/
!libs/fbx/lib/x64/**
